# Exports : ne JAMAIS commiter (données personnelles + tarifs réels)
*.xlsx
exports/

# LA FAMILLE - ne doit JAMAIS partir sur un dépôt public.
# Seuls les fichiers .exemple, avec des prénoms inventés, sont versionnés.
exclusions.txt
reglages.sql

# Les imports de tableurs sont des scripts de circonstance : ils versent
# des fichiers qui n'existent que chez l'organisateur. Ils restent sur le
# disque, pas dans le depot -- avec les tests qui les accompagnent, sans
# quoi la CI chercherait un module absent.
importer_presences.py
tests/test_import_presences.py
importer_tarifs.py
tests/test_import_tarifs.py
importer_activites.py
tests/test_import_activites.py

# Le tableur des presences porte les vrais prenoms, comme le GEDCOM ; ceux
# des prix portent les tarifs reellement negocies avec l'hotel. Les
# scripts les lisent la ou ils sont. Le filtre est large a dessein : aucun
# CSV n'a de raison d'entrer dans ce depot.
*.csv

# Un GEDCOM contient toute une genealogie : il reste hors du projet.
# `importer_ged.py --ged` le lit la ou il est, sans jamais le copier ici.
*.ged

# Config réelle (tarifs négociés) - seul config.example.toml est versionné
config.toml

# Données locales
donnees_locales.json
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
