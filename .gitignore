# Exports : ne JAMAIS commiter (données personnelles + tarifs réels)
*.xlsx
exports/

# LA FAMILLE - ne doit JAMAIS partir sur un dépôt public.
# Seuls les fichiers .exemple, avec des prénoms inventés, sont versionnés.
exclusions.txt
reglages.sql

# Le tableur des presences porte les vrais prenoms, comme le GEDCOM.
# `importer_presences.py --csv` le lit la ou il est. Le filtre est large
# a dessein : aucun CSV n'a de raison d'entrer dans ce depot.
*.csv

# Un GEDCOM contient toute une genealogie : il reste hors du projet.
# `importer_ged.py --ged` le lit la ou il est, sans jamais le copier ici.
*.ged

# Config réelle (tarifs négociés) - seul config.example.toml est versionné
config.toml

# Données locales
donnees_locales.json
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
